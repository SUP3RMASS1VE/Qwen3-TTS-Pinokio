{
  "requires": {
    "bundle": "ai"
  },
  "run": [
    {
      "method": "shell.run",
      "params": {
        "message": [
          "git clone https://github.com/SUP3RMASS1VE/Qwen3-TTS app"
        ]
      }
    },
    {
      "when": "{{platform === 'win32' && gpu === 'amd'}}",
      "method": "fs.copy",
      "params": {
        "src": "app_amd.py",
        "dest": "app/app_amd.py"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "venv": "venv",
        "path": "app",
        "chain": true,
        "input": null,
        "message": [
          "uv pip install -r requirements.txt"
        ]
      }
    },
    {
      "method": "script.start",
      "params": {
        "uri": "torch.js",
        "params": {
          "path": "app",
          "venv": "venv",
          "xformers": false,
          "triton": false,
          "sageattention": false
        }
      }
    }
  ]
}